# Database (Neon free tier)
DATABASE_URL=postgresql+asyncpg://user:pass@ep-xyz.us-east-2.aws.neon.tech/stockdash?sslmode=require

# Redis (Upstash free tier)
REDIS_URL=rediss://default:password@us1-xyz.upstash.io:6379

# Security (generate unique values!)
SECRET_KEY=generate-a-random-32-char-string-here
TOKEN_ENCRYPTION_KEY=generate-a-64-char-hex-string-here

# LLM
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile

# Broker
GROWW_API_KEY=your-groww-api-key
GROWW_API_SECRET=your-groww-api-secret
GROWW_ACCESS_TOKEN=your-daily-access-token

# App
ENVIRONMENT=production
CORS_ORIGINS=https://your-frontend.vercel.app

# News
NEWS_COLLECTION_TIMES=07:00,18:00
NEWS_RETENTION_DAYS=90

# Telemetry
TELEMETRY_PIN=your-pin
