# Database
DATABASE_URL=postgresql+asyncpg://stockdash:stockdash@localhost:5432/stockdash

# Redis
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=your-secret-key-min-32-chars
TOKEN_ENCRYPTION_KEY=your-32-byte-hex-encryption-key

# LLM (optional - defaults to stub)
LLM_PROVIDER=stub
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-haiku-20240307
OLLAMA_MODEL=llama3

# Market Data
FINNHUB_API_KEY=your-finnhub-api-key

# News Collection Schedule (IST times, comma-separated HH:MM)
NEWS_COLLECTION_TIMES=07:00,18:00
NEWS_RETENTION_DAYS=90

# Broker API Keys
GROWW_API_KEY=your-groww-api-key
ZERODHA_API_KEY=your-zerodha-api-key
ZERODHA_API_SECRET=your-zerodha-api-secret
SNAPTRADE_CLIENT_ID=your-snaptrade-client-id
SNAPTRADE_CONSUMER_KEY=your-snaptrade-consumer-key
ROBINHOOD_USERNAME=your-robinhood-username
ROBINHOOD_PASSWORD=your-robinhood-password

# App
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173
