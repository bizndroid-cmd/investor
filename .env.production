# =============================================================================
# Production Environment Variables
# Copy to .env on your VM and fill in real values
# =============================================================================

# --- Domain (used by Caddy for HTTPS certs) ---
DOMAIN=yourdomain.com

# --- PostgreSQL (internal, no external access) ---
POSTGRES_DB=stockdash
POSTGRES_USER=stockdash
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

# --- Redis (internal, password protected) ---
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD_HERE

# --- Security (generate unique values!) ---
# openssl rand -hex 32
SECRET_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
# openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32

# --- LLM Provider ---
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_YOUR_GROQ_KEY_HERE
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=YOUR_GEMINI_KEY_HERE
GEMINI_MODEL=gemini-2.0-flash-lite

# --- Groww Broker ---
GROWW_API_KEY=YOUR_GROWW_API_KEY
GROWW_API_SECRET=YOUR_GROWW_API_SECRET
GROWW_ACCESS_TOKEN=YOUR_GROWW_ACCESS_TOKEN

# --- Other Brokers (empty if not used) ---
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=
ROBINHOOD_USERNAME=
ROBINHOOD_PASSWORD=

# --- Market Data ---
FINNHUB_API_KEY=

# --- App Config ---
ENVIRONMENT=production
CORS_ORIGINS=https://yourdomain.com

# --- News ---
NEWS_COLLECTION_TIMES=07:00,18:00
NEWS_RETENTION_DAYS=90

# --- Telemetry ---
TELEMETRY_PIN=CHANGE_ME_YOUR_PIN
